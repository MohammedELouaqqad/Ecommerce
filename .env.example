# Modele du fichier .env : le copier en .env puis remplir les valeurs.
# .env est ignore par Git ; ce fichier-ci ne doit jamais contenir de vraie valeur.

# --- Securite ---
# Cle de signature JWT, partagee par api-gateway et user-service.
# Base64, 256 bits minimum. A generer avec :  openssl rand -base64 32
JWT_SECRET=

# Origine(s) autorisee(s) a appeler l'API depuis un navigateur, separees par des virgules.
# Ce n'est pas un secret : en production, mettre le domaine du frontend.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Premier compte Admin, cree au demarrage uniquement si aucun Admin n'existe.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Base de donnees (user, product et order-service) ---
# Doit correspondre a MYSQL_ROOT_PASSWORD du service mysqldb, ecrit en dur dans le compose.
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

# --- Assistant IA (ai-service) ---
# Pour l'activer : OPENAI_ENABLED=true ET SPRING_AI_MODEL_CHAT=openai, plus une vraie cle.
OPENAI_ENABLED=false
SPRING_AI_MODEL_CHAT=none
OPEN_AI_KEY=

# --- Stockage des images (s3-service) ---
# Pour l'activer : AWS_S3_ENABLED=true, plus des identifiants AWS et un bucket.
AWS_S3_ENABLED=false
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
AWS_REGION=
AWS_BUCKET_NAME=
