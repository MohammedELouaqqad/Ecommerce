# Modele du fichier .env : le copier en .env puis remplir les valeurs.
# .env est ignore par Git ; ce fichier-ci ne doit jamais contenir de vraie valeur.

# Cle de signature des tokens JWT, partagee par api-gateway et user-service.
# Base64, 256 bits minimum. A generer avec :  openssl rand -base64 32
JWT_SECRET=

# Premier compte Admin, cree au demarrage uniquement si aucun Admin n'existe.
ADMIN_EMAIL=
ADMIN_PASSWORD=
